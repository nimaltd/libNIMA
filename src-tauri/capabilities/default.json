{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window is allowed to do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open"
  ]
}
